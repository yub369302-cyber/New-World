# ============================================
# Job Hunter AI 求职助手 - 配置文件
# 复制此文件为 .env 并填入你的真实信息
# ============================================

# --- OpenAI API (用于AI匹配和生成) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- SerpAPI (用于聚合搜索招聘信息) ---
# 注册地址: https://serpapi.com/ (每月免费100次搜索)
SERPAPI_KEY=your-serpapi-key-here

# --- 邮箱配置 (用于发送每日推送) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
RECIPIENT_EMAIL=your-email@example.com

# --- 求职配置 ---
JOB_KEYWORDS=数据分析实习,审计实习
JOB_CITIES=北京,南京
JOB_TYPE=实习
JOB_EXCLUDE_KEYWORDS=Senior,Lead,高级,资深,5年以上,3年以上

# --- 个人简历摘要 (AI会根据这个匹配和定制建议) ---
RESUME_SUMMARY=你的个人简历摘要

# --- Supabase 云端数据库 (用于多用户账号和档案存储) ---
# 注册地址: https://supabase.com/
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# --- 调度配置 ---
SCHEDULE_HOURS=10,16,22,4
