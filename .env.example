# ============================================
# Job Hunter AI 求职助手 - 配置文件
# 复制此文件为 .env 并填入你的真实信息
# ============================================

# --- OpenAI API (用于AI匹配和生成) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- SerpAPI (用于聚合搜索招聘信息) ---
# 注册地址: https://serpapi.com/ (每月免费100次搜索)
SERPAPI_KEY=your-serpapi-key-here

# --- 邮箱配置 (用于发送每日推送) ---
SMTP_HOST=smtp.153.com
SMTP_PORT=465
SMTP_USER=18606195710@153.com
SMTP_PASSWORD=your-email-password
RECIPIENT_EMAIL=18606195710@153.com

# --- 求职配置 ---
JOB_KEYWORDS=数据分析实习,审计实习,投行实习,金融分析实习,数据运营实习
JOB_CITIES=北京,南京,苏州,无锡
JOB_TYPE=实习
# 排除关键词（过滤不相关岗位）
JOB_EXCLUDE_KEYWORDS=Senior,Lead,高级,资深,5年以上,3年以上

# --- 个人简历摘要 (AI会根据这个匹配和定制建议) ---
RESUME_SUMMARY=审计专业在校大学生，具备扎实的数据分析能力。熟练使用SQL进行数据查询与处理，精通Excel（包括VBA、数据透视表），能够使用Tableau进行数据可视化，具备简单的Python编程能力。曾在券商投行部实习，参与IPO项目的尽职调查和财务分析工作，熟悉金融行业业务流程。具有良好的逻辑思维能力和文档撰写能力。

# --- 调度配置 ---
# 每6小时执行一次: 10:00, 16:00, 22:00, 04:00
SCHEDULE_HOURS=10,16,22,4
